            <SQLTask:SqlTaskData
              SQLTask:Connection="{7F119B7D-4B55-400B-B357-7E44ECB47AA3}"
              SQLTask:TimeOut="0"
              SQLTask:SqlStatementSource="-- ACTUALIZA DIM_ESTABLECIMIENTO&#xA;UPDATE T1&#xA;SET T1.NombreEESS = T2.NombreEESS&#xA;  , T1.CategoriaEESS = T2.CategoriaEESS&#xA;  , T1.Diresa = T2.Diresa&#xA;  , T1.Red = T2.Red&#xA;  , T1.Microred = T2.Microred&#xA;  , T1.Departamento = T2.Departamento&#xA;  , T1.Provincia = T2.Provincia&#xA;  , T1.Distrito = T2.Distrito&#xA;  , T1.FechaActualizacion = GETDATE()&#xA;FROM Dim_Establecimiento T1 INNER JOIN TMP_Establecimiento T2 ON T1.CodRenipress = T2.CodRenipress;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
