              SQLTask:TimeOut="0"
              SQLTask:SqlStatementSource="-- ACTUALIZA DIM_GEOGRAFIA&#xA;UPDATE T1&#xA;SET T1.Departamento = T2.Departamento&#xA;  , T1.Provincia = T2.Provincia&#xA;  , T1.Distrito = T2.Distrito&#xA;  , T1.FechaActualizacion = GETDATE()&#xA;FROM Dim_Geografia T1 INNER JOIN TMP_Geografia T2 ON T1.Ubigeo = T2.Ubigeo;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
