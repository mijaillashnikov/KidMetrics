          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\DIM_GEOGRAFIA\CARGA DIM_GEOGRAFIA\ORIGEN SA_PERU"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="Origen de OLE DB;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Todos los derechos reservados; http://www.microsoft.com/sql/support;7"
                  description="Origen de OLE DB"
                  name="ORIGEN SA_PERU"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property dataType="System.Int32" description="Número de segundos antes de que se agote el tiempo de espera de un comando. Un valor de 0 indica un tiempo de espera infinito." name="CommandTimeout">0</property>
                    <property dataType="System.String" description="Especifica el nombre del objeto de base de datos usado para abrir un conjunto de filas." name="OpenRowset"></property>
                    <property dataType="System.String" description="Especifica la variable que contiene el nombre del objeto de base de datos usado para abrir un conjunto de filas." name="OpenRowsetVariable"></property>
                    <property dataType="System.String" description="Comando SQL para ejecutar." name="SqlCommand" UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT  T1.Ubigeo
      , T1.Departamento
      , T1.Provincia
      , T1.Distrito
FROM
    (
        SELECT ROW_NUMBER() OVER (PARTITION BY T1.Ubigeo
                                  ORDER BY T1.Cantidad DESC, T1.Departamento, T1.Provincia, T1.Distrito) AS NRO
             , T1.*
        FROM
            (
                SELECT T1.Ubigeo, T1.Departamento, T1.Provincia, T1.Distrito, COUNT(*) AS Cantidad
                FROM
                    (
                        SELECT CAST(RIGHT('000000' + CAST(CAST(dbo.fn_Num(T1.UBIGE0REN_SA) AS INT) AS VARCHAR(6)), 6) AS VARCHAR(6))  AS Ubigeo
                             , CAST(ISNULL(NULLIF(UPPER(TRIM(T1.DEPARTAMENTOREN_SA)), ''), 'SIN DATO') AS VARCHAR(50))  AS Departamento
                             , CAST(ISNULL(NULLIF(UPPER(TRIM(T1.PROVINCIAREN_SA)), ''), 'SIN DATO')    AS VARCHAR(80))  AS Provincia
                             , CAST(ISNULL(NULLIF(UPPER(TRIM(T1.DISTRITOREN_SA)), ''), 'SIN DATO')     AS VARCHAR(80))  AS Distrito
                        FROM SA_PERU T1
                        WHERE dbo.fn_Num(T1.UBIGE0REN_SA) &gt; 0
                        UNION ALL
                        SELECT CAST(RIGHT('000000' + CAST(CAST(dbo.fn_Num(T1.UBIGEOPN_SA) AS INT) AS VARCHAR(6)), 6) AS VARCHAR(6))
                             , CAST(ISNULL(NULLIF(UPPER(TRIM(T1.DEPARTAMENTOPN_SA)), ''), 'SIN DATO') AS VARCHAR(50))
                             , CAST(ISNULL(NULLIF(UPPER(TRIM(T1.PROVINCIAPN_SA)), ''), 'SIN DATO')    AS VARCHAR(80))
                             , CAST(ISNULL(NULLIF(UPPER(TRIM(T1.DISTRITOPN_SA)), ''), 'SIN DATO')     AS VARCHAR(80))
                        FROM SA_PERU T1
                        WHERE dbo.fn_Num(T1.UBIGEOPN_SA) &gt; 0
                    ) T1
                GROUP BY T1.Ubigeo, T1.Departamento, T1.Provincia, T1.Distrito
            ) T1
    ) T1
WHERE T1.NRO = 1
UNION ALL
SELECT CAST('000000' AS VARCHAR(6)), CAST('SIN DATO' AS VARCHAR(50)), CAST('SIN DATO' AS VARCHAR(80)), CAST('SIN DATO' AS VARCHAR(80))</property>
                    <property dataType="System.String" description="Variable que contiene el comando SQL para ejecutar." name="SqlCommandVariable"></property>
